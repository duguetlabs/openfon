{
  "name": "openfon",
  "version": "0.1.0",
  "description": "Open-source AI phone agent for small businesses. Self-hostable on Cloudflare Workers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build && node scripts/site-metadata.mjs",
    "deploy": "npm run build && npm run db:migrate && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply openfon --local",
    "db:migrate": "wrangler d1 migrations apply openfon --remote",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.99.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
