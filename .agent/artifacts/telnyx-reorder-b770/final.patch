diff --git a/test/telnyx-reorder-boundary.test.ts b/test/telnyx-reorder-boundary.test.ts
new file mode 100644
index 0000000..307f050
--- /dev/null
+++ b/test/telnyx-reorder-boundary.test.ts
@@ -0,0 +1,207 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { TelnyxMediaAdapter } from '../src/telnyx-media';
+import { encodePcmuFrame, Pcmu8ToPcm24 } from '../src/telephony-audio';
+
+const identity = { callControlId: 'control', callSessionId: 'session', authToken: 'synthetic-reorder' };
+const connected = { event: 'connected', version: '1.0.0', connected: { 'x-telnyx-streaming-auth-token': identity.authToken } };
+const start = { event: 'start', stream_id: 'stream', sequence_number: '1', start: {
+  call_control_id: 'control', call_session_id: 'session', media_format: { encoding: 'PCMU', sample_rate: 8000, channels: 1 },
+} };
+const ready = { type: 'ready', mode: 'realtime', ttsMode: 'realtime' };
+const payload = (chunk: number, bytes = 160) => encodePcmuFrame(Uint8Array.from(
+  { length: bytes }, (_, i) => ((chunk * 29 + i * 7) % 200) + 20,
+));
+const media = (chunk: number, bytes = 160, fields: Record<string, unknown> = {}) => ({
+  event: 'media', stream_id: 'stream', sequence_number: String(chunk + 1),
+  media: { chunk: String(chunk), timestamp: String(chunk * 20), track: 'inbound', payload: payload(chunk, bytes), ...fields },
+});
+interface InputState {
+  reorder: Map<number, { bytes: number }>;
+  reorderBytes: number;
+  preReadyBytes: number;
+  nextChunk: number;
+  gap?: ReturnType<typeof setTimeout>;
+}
+const adapters: TelnyxMediaAdapter[] = [];
+function fixture(onStart?: () => Promise<void>) {
+  const sent: Array<string | ArrayBuffer> = [];
+  const onEnd = vi.fn();
+  const adapter = new TelnyxMediaAdapter({ expected: identity, carrierSend: () => {}, sessionSend: value => sent.push(value), onEnd, onStart });
+  adapters.push(adapter);
+  const state = adapter as unknown as InputState;
+  // Observe every insertion, including any transient eleventh entry, rather
+  // than inspecting only the already-drained map after carrierMessage returns.
+  const set = state.reorder.set.bind(state.reorder);
+  vi.spyOn(state.reorder, 'set').mockImplementation((key, packet) => {
+    const result = set(key, packet);
+    expect(result.size).toBeLessThanOrEqual(10);
+    expect([...result.values()].reduce((bytes, value) => bytes + value.bytes, 0)).toBeLessThanOrEqual(8000);
+    return result;
+  });
+  const receive = (value: unknown) => adapter.carrierMessage(JSON.stringify(value));
+  const server = (value: unknown) => adapter.sessionMessage(JSON.stringify(value));
+  const boot = async (isReady = true) => { await receive(connected); await receive(start); if (isReady) server(ready); };
+  const pcm = () => sent.filter((value): value is ArrayBuffer => value instanceof ArrayBuffer);
+  return { adapter, state, sent, onEnd, receive, server, boot, pcm };
+}
+function reference(chunks: number[], bytes = 160) {
+  const converter = new Pcmu8ToPcm24();
+  return chunks.map(chunk => converter.push(payload(chunk, bytes)).buffer);
+}
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => {
+  for (const adapter of adapters.splice(0)) adapter.close();
+  vi.restoreAllMocks();
+  vi.useRealTimers();
+});
+
+describe('Telnyx count-bound input recovery without byte-budget expansion', () => {
+  it.each([true, false])('[reorder-count-negative] drains ten ahead packets when the expected chunk arrives (ready=%s)', async isReady => {
+    const f = fixture(); await f.boot(isReady);
+    for (let chunk = 2; chunk <= 11; chunk++) await f.receive(media(chunk));
+    expect(f.state.reorder.size).toBe(10); expect(f.state.reorderBytes).toBe(1600);
+    expect(f.pcm()).toHaveLength(0);
+    vi.advanceTimersByTime(99);
+    await f.receive(media(1));
+    expect(f.onEnd).not.toHaveBeenCalled();
+    expect(f.state.reorder.size).toBe(0); expect(f.state.reorderBytes).toBe(0);
+    expect(f.state.nextChunk).toBe(12); expect(f.state.gap).toBeUndefined();
+    if (!isReady) {
+      expect(f.pcm()).toHaveLength(0); expect(f.state.preReadyBytes).toBe(11 * 960);
+      f.server(ready); expect(f.state.preReadyBytes).toBe(0);
+    }
+    expect(f.pcm()).toEqual(reference(Array.from({ length: 11 }, (_, i) => i + 1)));
+    vi.advanceTimersByTime(101);
+    expect(f.pcm()).toHaveLength(11); expect(f.onEnd).not.toHaveBeenCalled();
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it.each([800, 801])('retains aggregate admission at ten ahead packets plus a %s-byte head', async headBytes => {
+    const f = fixture(); await f.boot();
+    for (let chunk = 2; chunk <= 11; chunk++) await f.receive(media(chunk, 720));
+    expect(f.state.reorderBytes).toBe(7200); expect(f.state.reorder.size).toBe(10);
+    const convert = vi.spyOn(Pcmu8ToPcm24.prototype, 'push');
+    await f.receive(media(1, headBytes));
+    if (headBytes === 801) {
+      expect(f.onEnd).toHaveBeenCalledExactlyOnceWith('invalid_carrier_frame');
+      expect(convert).not.toHaveBeenCalled();
+      expect(f.pcm()).toHaveLength(0); expect(vi.getTimerCount()).toBe(0);
+    } else {
+      expect(f.onEnd).not.toHaveBeenCalled();
+      const converter = new Pcmu8ToPcm24();
+      const expected = [converter.push(payload(1, 800)).buffer];
+      for (let chunk = 2; chunk <= 11; chunk++) expected.push(converter.push(payload(chunk, 720)).buffer);
+      expect(f.pcm()).toEqual(expected); expect(f.state.reorderBytes).toBe(0);
+    }
+  });
+
+  it.each([1, 7])('rejects another chunk %s at an already full 8000-byte buffer, before delivery', async chunk => {
+    const f = fixture(); await f.boot();
+    for (let ahead = 2; ahead <= 6; ahead++) await f.receive(media(ahead, 1600));
+    expect(f.state.reorder.size).toBe(5); expect(f.state.reorderBytes).toBe(8000);
+    const convert = vi.spyOn(Pcmu8ToPcm24.prototype, 'push');
+    await f.receive(media(chunk, 1));
+    expect(f.onEnd).toHaveBeenCalledExactlyOnceWith('invalid_carrier_frame');
+    expect(convert).not.toHaveBeenCalled();
+    expect(f.pcm()).toHaveLength(0); expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('accepts exactly 8000 aggregate bytes below the count cap', async () => {
+    const f = fixture(); await f.boot();
+    for (let chunk = 2; chunk <= 5; chunk++) await f.receive(media(chunk, 1600));
+    await f.receive(media(1, 1600));
+    expect(f.onEnd).not.toHaveBeenCalled(); expect(f.pcm()).toEqual(reference([1, 2, 3, 4, 5], 1600));
+    expect(f.state.reorderBytes).toBe(0);
+  });
+
+  it('keeps latest whole-packet pre-ready PCM bounded while onStart is still pending', async () => {
+    let release!: () => void;
+    const f = fixture(() => new Promise<void>(resolve => { release = resolve; }));
+    await f.receive(connected); const starting = f.receive(start);
+    for (let chunk = 1; chunk <= 12; chunk++) {
+      await f.receive(media(chunk, 1600));
+      expect(f.state.preReadyBytes).toBeLessThanOrEqual(48000);
+      expect(f.state.reorderBytes).toBe(0);
+    }
+    expect(f.sent).toEqual([]); expect(f.onEnd).not.toHaveBeenCalled();
+    release(); await starting;
+    expect(f.sent).toEqual(['{"type":"start"}']);
+    f.server(ready);
+    expect(f.pcm()).toEqual(reference(Array.from({ length: 12 }, (_, i) => i + 1), 1600).slice(-5));
+    expect(f.state.preReadyBytes).toBe(0); expect(f.onEnd).not.toHaveBeenCalled();
+  });
+
+  it('keeps distance ten accepted and eleven rejected', async () => {
+    const f = fixture(); await f.boot();
+    await f.receive(media(11)); expect(f.state.reorder.size).toBe(1); expect(f.onEnd).not.toHaveBeenCalled();
+    await f.receive(media(12));
+    expect(f.onEnd).toHaveBeenCalledExactlyOnceWith('invalid_carrier_frame'); expect(f.pcm()).toHaveLength(0);
+  });
+
+  it.each([
+    { label: 'noncanonical padding', invalid: 'AB==' },
+    { label: 'invalid alphabet', invalid: '%%%=' },
+    { label: 'over 1600 decoded bytes', invalid: 'AAAA'.repeat(534) },
+  ])('rejects $label in the expected payload at the count boundary', async ({ invalid }) => {
+    const f = fixture(); await f.boot();
+    for (let chunk = 2; chunk <= 11; chunk++) await f.receive(media(chunk));
+    await f.receive(media(1, 160, { payload: invalid }));
+    expect(f.onEnd).toHaveBeenCalledExactlyOnceWith('invalid_carrier_frame'); expect(f.pcm()).toHaveLength(0);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('ignores duplicate/late malformed payloads before decoding and never delivers twice', async () => {
+    const f = fixture(); await f.boot();
+    for (let chunk = 2; chunk <= 11; chunk++) await f.receive(media(chunk));
+    const decode = vi.spyOn(globalThis, 'atob'); decode.mockClear();
+    await f.receive(media(2, 160, { payload: '%%%' }));
+    expect(decode).not.toHaveBeenCalled(); expect(f.state.reorder.size).toBe(10);
+    await f.receive(media(1)); expect(f.onEnd).not.toHaveBeenCalled();
+    decode.mockClear(); await f.receive(media(1, 160, { payload: '%%%' }));
+    expect(decode).not.toHaveBeenCalled(); expect(f.pcm()).toHaveLength(11); expect(f.onEnd).not.toHaveBeenCalled();
+  });
+
+  it.each(['head-sequence', 'head-timestamp', 'queued-sequence', 'queued-timestamp'])('preserves chunk-ordered rejection for %s', async kind => {
+    const f = fixture(); await f.boot(); await f.receive(media(1));
+    const queued = media(3);
+    if (kind === 'queued-sequence') queued.sequence_number = '3';
+    if (kind === 'queued-timestamp') queued.media.timestamp = '39';
+    await f.receive(queued);
+    const head = media(2);
+    if (kind === 'head-sequence') head.sequence_number = '2';
+    if (kind === 'head-timestamp') head.media.timestamp = '19';
+    await f.receive(head);
+    expect(f.onEnd).toHaveBeenCalledExactlyOnceWith('invalid_carrier_frame');
+    expect(f.pcm()).toEqual(reference(kind.startsWith('head') ? [1] : [1, 2]));
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('allows equal timestamps with increasing sequence and keeps FIR continuous', async () => {
+    const f = fixture(); await f.boot();
+    await f.receive(media(2, 160, { timestamp: '20' })); await f.receive(media(1));
+    expect(f.onEnd).not.toHaveBeenCalled(); expect(f.pcm()).toEqual(reference([1, 2]));
+  });
+
+  it('keeps the original gap deadline after a partial direct drain and resets FIR only for loss', async () => {
+    const f = fixture(); await f.boot();
+    await f.receive(media(3)); vi.advanceTimersByTime(60);
+    await f.receive(media(1)); expect(f.pcm()).toEqual(reference([1]));
+    vi.advanceTimersByTime(39); expect(f.pcm()).toHaveLength(1);
+    vi.advanceTimersByTime(1);
+    expect(f.pcm()).toEqual([...reference([1]), ...reference([3])]);
+    expect(f.state.nextChunk).toBe(4); expect(f.state.gap).toBeUndefined();
+    await f.receive(media(2)); expect(f.pcm()).toHaveLength(2);
+    expect(f.onEnd).not.toHaveBeenCalled();
+  });
+
+  it('ending clears pending input and its gap timer without forwarding late packets', async () => {
+    const f = fixture(); await f.boot();
+    for (let chunk = 2; chunk <= 11; chunk++) await f.receive(media(chunk));
+    f.server({ type: 'ending' });
+    expect(f.state.reorder.size).toBe(0); expect(f.state.reorderBytes).toBe(0); expect(f.state.gap).toBeUndefined();
+    await f.receive(media(1)); vi.advanceTimersByTime(100);
+    expect(f.pcm()).toHaveLength(0); expect(f.onEnd).not.toHaveBeenCalled();
+    f.adapter.close(); vi.advanceTimersByTime(20000);
+    expect(f.onEnd).toHaveBeenCalledTimes(1); expect(f.pcm()).toHaveLength(0); expect(vi.getTimerCount()).toBe(0);
+  });
+});
