diff --git a/scripts/e2e-server.test.mjs b/scripts/e2e-server.test.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/e2e-server.test.mjs
@@ -0,0 +1,200 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { EventEmitter } from 'node:events';
+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+// Extract only the actual shutdown handlers, never import the application server.
+// Neither build/migrations, npx/workerd, HTTP/provider nor browser is started.
+const source = readFileSync(process.env.E2E_SERVER_SOURCE || new URL('./e2e-server.mjs', import.meta.url), 'utf8');
+const marker = source.includes('const requestedShutdownSignals = new Set();')
+  ? 'const requestedShutdownSignals = new Set();'
+  : "for (const signal of ['SIGINT', 'SIGTERM'])";
+assert.equal(source.split(marker).length, 2, 'unique lifecycle tail');
+const tail = source.slice(source.indexOf(marker));
+
+async function bounded(promise) {
+  let timer;
+  try {
+    return await Promise.race([promise, new Promise((_, reject) => {
+      timer = setTimeout(() => reject(new Error('TEST_WATCHDOG: wrapper did not settle')), 2000);
+    })]);
+  } finally { clearTimeout(timer); }
+}
+
+const childSource = `
+const settings = JSON.parse(process.argv[1]);
+for (const signal of settings.holdSignals || []) process.on(signal, () => process.send({ kind: 'held', signal }));
+if (settings.termExitCode !== undefined) process.on('SIGTERM', () => process.exit(settings.termExitCode));
+process.on('message', message => {
+  if (message.kind === 'exit-code') process.exit(message.code);
+  if (message.kind === 'signal-self') {
+    process.removeAllListeners(message.signal);
+    process.kill(process.pid, message.signal);
+  }
+});
+process.send({ kind: 'ready' });
+`;
+
+function launch(settings = {}) {
+  const directory = mkdtempSync(join(tmpdir(), 'openfon-wrapper-test-'));
+  const state = join(directory, 'state');
+  const eventsFile = join(directory, 'events.jsonl');
+  const wrapperFile = join(directory, 'wrapper.mjs');
+  mkdirSync(state);
+  const harness = `
+import { spawn } from 'node:child_process';
+import { appendFileSync, rmSync as removeState } from 'node:fs';
+const state = ${JSON.stringify(state)};
+const record = event => appendFileSync(${JSON.stringify(eventsFile)}, JSON.stringify(event) + '\\n');
+const provider = { close() { record({ kind: 'provider-close' }); } };
+const rmSync = (path, options) => {
+  if (path !== state) throw new Error('Unexpected removal target');
+  removeState(path, options);
+  record({ kind: 'state-removed' });
+};
+const worker = ${settings.spawnFailure
+    ? `spawn(${JSON.stringify(join(directory, 'missing-executable'))}, [], { stdio: 'ignore' })`
+    : `spawn(process.execPath, ['-e', ${JSON.stringify(childSource)}, ${JSON.stringify(JSON.stringify(settings))}], { stdio: ['ignore', 'ignore', 'ignore', 'ipc'] })`};
+record({ kind: 'child-created', pid: worker.pid });
+worker.on('error', error => record({ kind: 'child-error', code: error.code }));
+worker.on('exit', (code, signal) => record({ kind: 'child-exit', code, signal }));
+const kill = worker.kill.bind(worker);
+worker.kill = signal => {
+  const sent = kill(signal);
+  record({ kind: 'forwarded', signal, sent });
+  return sent;
+};
+worker.on('message', message => process.send(message));
+process.on('message', message => {
+  if (message.kind === 'dispose') worker.kill('SIGKILL');
+  else worker.send(message);
+});
+${tail}
+`;
+  writeFileSync(wrapperFile, harness);
+  const wrapper = spawn(process.execPath, [wrapperFile], { stdio: ['ignore', 'pipe', 'pipe', 'ipc'] });
+  const messages = [];
+  const pending = new Map();
+  let stderr = '';
+  wrapper.stderr.on('data', chunk => { stderr += chunk; });
+  wrapper.on('message', message => {
+    const key = `${message.kind}:${message.signal || ''}`;
+    const resolve = pending.get(key);
+    if (resolve) { pending.delete(key); resolve(message); }
+    else messages.push(message);
+  });
+  const done = new Promise(resolve => {
+    wrapper.once('exit', (code, signal) => resolve({ code, signal }));
+    wrapper.once('error', error => resolve({ error: error.message }));
+  });
+  const events = () => existsSync(eventsFile)
+    ? readFileSync(eventsFile, 'utf8').trim().split('\n').filter(Boolean).map(line => JSON.parse(line)) : [];
+  return {
+    wrapper, state, events, done,
+    stderr: () => stderr,
+    wait(kind, signal = '') {
+      const index = messages.findIndex(message => message.kind === kind && (message.signal || '') === signal);
+      if (index >= 0) return Promise.resolve(messages.splice(index, 1)[0]);
+      return bounded(new Promise(resolve => pending.set(`${kind}:${signal}`, resolve)));
+    },
+    send(message) { wrapper.send(message); },
+    async dispose() {
+      try {
+        if (wrapper.exitCode === null && wrapper.signalCode === null) {
+          // Ask the fixture wrapper to reap its owned child first.
+          wrapper.send({ kind: 'dispose' }, () => {});
+          try { await bounded(done); }
+          catch (error) {
+            // Watchdog fallback belongs only to this test fixture, not product code.
+            const pid = events().find(event => event.kind === 'child-created')?.pid;
+            if (pid) { try { process.kill(pid, 'SIGKILL'); } catch (failure) { if (failure.code !== 'ESRCH') throw failure; } }
+            wrapper.kill('SIGKILL');
+            await bounded(done);
+            throw error;
+          }
+        }
+      } finally { rmSync(directory, { recursive: true, force: true }); }
+    },
+  };
+}
+
+async function check(t, settings, act, expected) {
+  const fixture = launch(settings);
+  try {
+    if (!settings.spawnFailure) await fixture.wait('ready');
+    await act(fixture);
+    const result = await bounded(fixture.done);
+    const events = fixture.events();
+    // Preserve child/wrapper outcomes before assertions, including original failures.
+    t.diagnostic(JSON.stringify({ scope: 'actual tail; real owned Node wrapper/child; provider stub', result, events, stderr: fixture.stderr() }));
+    assert.equal(result.signal, null, 'wrapper exits numerically through its actual handler');
+    assert.equal(result.code, expected);
+    assert.equal(existsSync(fixture.state), false);
+    assert.equal(events.filter(event => event.kind === 'state-removed').length, 1);
+    if (!settings.spawnFailure) {
+      assert.equal(events.filter(event => event.kind === 'provider-close').length, 1);
+      const exit = events.findIndex(event => event.kind === 'child-exit');
+      const close = events.findIndex(event => event.kind === 'provider-close');
+      const remove = events.findIndex(event => event.kind === 'state-removed');
+      assert.ok(exit < close && close < remove);
+    } else {
+      assert.equal(events.find(event => event.kind === 'child-error')?.code, 'ENOENT');
+    }
+  } finally { await fixture.dispose(); }
+}
+
+for (const code of [0, 7]) {
+  test(`numeric child exit ${code} is preserved`, t => check(t, {}, async f => f.send({ kind: 'exit-code', code }), code));
+}
+for (const signal of ['SIGTERM', 'SIGKILL']) {
+  test(`unexpected direct-child ${signal} is failure`, t => check(t, {}, async f => f.send({ kind: 'signal-self', signal }), 1));
+}
+for (const signal of ['SIGTERM', 'SIGINT']) {
+  test(`accepted wrapper-requested ${signal} is successful shutdown`, t => check(t, {}, async f => {
+    assert.equal(f.wrapper.kill(signal), true);
+  }, 0));
+}
+test('numeric nonzero remains failure after accepted shutdown request', t => check(t, { termExitCode: 7 }, async f => {
+  assert.equal(f.wrapper.kill('SIGTERM'), true);
+}, 7));
+test('different child signal is failure after accepted request', t => check(t, { holdSignals: ['SIGTERM'] }, async f => {
+  assert.equal(f.wrapper.kill('SIGTERM'), true);
+  await f.wait('held', 'SIGTERM');
+  f.send({ kind: 'signal-self', signal: 'SIGKILL' });
+}, 1));
+test('matching any of multiple accepted requests succeeds', t => check(t, { holdSignals: ['SIGTERM', 'SIGINT'] }, async f => {
+  assert.equal(f.wrapper.kill('SIGTERM'), true);
+  await f.wait('held', 'SIGTERM');
+  assert.equal(f.wrapper.kill('SIGINT'), true);
+  await f.wait('held', 'SIGINT');
+  f.send({ kind: 'signal-self', signal: 'SIGTERM' });
+}, 0));
+test('real spawn error preserves existing failure and state cleanup', t => check(t, { spawnFailure: true }, async () => {}, 1));
+
+// Synthetic controls inspect acceptance after failed forwarding. For the throw
+// case only, the test catches the callback error and supplies a later exit;
+// a real uncaught callback throw would already fail the wrapper process.
+for (const forwarding of ['false', 'throw', 'no-request']) {
+  test(`synthetic ${forwarding} forwarding never authorizes zero`, () => {
+    const processStub = new EventEmitter();
+    const worker = new EventEmitter();
+    const failure = new Error('synthetic forwarding failure');
+    let status;
+    let closes = 0;
+    let removals = 0;
+    worker.kill = () => { if (forwarding === 'throw') throw failure; return false; };
+    processStub.exit = code => { status = code; };
+    new Function('process', 'worker', 'provider', 'rmSync', 'state', 'console', tail)(
+      processStub, worker, { close() { closes++; } }, () => { removals++; }, 'synthetic-state', { error() {} },
+    );
+    if (forwarding === 'throw') assert.throws(() => processStub.emit('SIGTERM'), error => error === failure);
+    else if (forwarding === 'false') processStub.emit('SIGTERM');
+    worker.emit('exit', null, forwarding === 'no-request' ? null : 'SIGTERM');
+    assert.equal(status, 1);
+    assert.equal(closes, 1);
+    assert.equal(removals, 1);
+  });
+}
