+function validBody() {
+  const body = JSON.stringify({ data: { id: 'admission-fixture', record_type: 'event', event_type: 'call.hangup',
+    occurred_at: new Date().toISOString(), payload: { call_control_id: 'control', call_leg_id: 'leg', call_session_id: 'session',
