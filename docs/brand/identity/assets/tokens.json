{
  "name": "OpenFon",
  "version": "1.0.0",
  "colors": {
    "blue": "#2457c5",
    "blue-deep": "#18449f",
    "ink": "#152a49",
    "butter": "#f6e99b",
    "paper": "#f3f5f8",
    "white": "#ffffff",
    "muted": "#5f708a",
    "line": "#dce3ed",
    "success": "#216246",
    "error": "#a52f3f"
  },
  "fonts": {
    "display": "Lilita One",
    "body": "Nunito Sans",
    "appCurrent": "Avenir Next, Avenir, Segoe UI, system-ui, sans-serif"
  },
  "radius": {
    "control": "8px",
    "sheet": "16px"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    80
  ],
  "logo": {
    "master": "../../lilita-f-variants/4-straighter-stem-tight-spacing.svg",
    "minimumWidthPx": 120,
    "clearSpace": "At least half the lowercase o height on every side"
  },
  "motion": {
    "duration": "180ms",
    "easing": "cubic-bezier(.16,1,.3,1)",
    "reduceMotion": true
  }
