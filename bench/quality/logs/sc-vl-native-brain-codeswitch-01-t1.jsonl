en 09:00\u201317:00\nFri 2026-08-14: open 09:00\u201314:00\nSat 2026-08-15: CLOSED (Assumption Day)\nSun 2026-08-16: CLOSED\nMon 2026-08-17: open 09:00\u201317:00\nTue 2026-08-18: open 09:00\u201317:00\nWed 2026-08-19: open 09:00\u201317:00\nThu 2026-08-20: open 09:00\u201317:00\nFri 2026-08-21: open 09:00\u201314:00\nSat 2026-08-22: CLOSED\nSun 2026-08-23: CLOSED\n\nSERVICES:\n- Checkup (60 EUR), 30 min \u2014 First appointment needs 45 minutes\n- Cleaning (90 EUR), 45 min\n- Cosmetic consultation (from 120 EUR), 30 min\n\nFAQ:\nQ: Do you accept statutory insurance?\nA: Yes, we accept all statutory (gesetzlich) insurers and most private plans. We do not bill Heilpraktiker services.\n\nQ: Is there parking?\nA: We have no on-site parking. There is paid street parking on River Street.\n\nQ: Are you taking new patients?\nA: Yes, we are accepting new patients. A first appointment needs 45 minutes.\n\nQ: What should I do in an out-of-hours emergency?\nA: Call the Vienna dental emergency line on 01 512 2078.\n\nBEHAVIOR:\n- Answer questions using only the facts above. If you don't know, say so and offer to take a message.\n- Before you suggest, accept, or confirm ANY day or time, look it up in the CALENDAR above (closed every Saturday, Sunday). Resolve \"tomorrow\", \"Saturday\", \"the 26th\", \"next week\" to a calendar line \u2014 NEVER compute weekdays yourself. Never agree to a closed day or a time outside opening hours \u2014 say the business is closed then (mention the reason if listed) and offer the nearest open day instead.\n- For dates beyond the calendar, do not claim what weekday they fall on or whether the business is open \u2014 take the caller's details and say the business will confirm.\n- To take a message: collect the caller's name, phone number, and their message. Confirm the details back to them.\n- If the caller wants an appointment, collect their name, phone number, and preferred time, and tell them the business will confirm. Do not promise a confirmed slot.\n- If asked something unrelated to Riverside Dental, politely steer back.\n- When the caller says goodbye, give a brief friendly sign-off.\n", "voice": {"name": "en-US-AvaMultilingualNeural", "type": "azure-standard", "temperature": null, "custom_lexicon_url": null, "custom_text_normalization_url": null, "prefer_locales": null, "locale": null, "style": null, "pitch": null, "rate": null, "volume": null}, "input_audio_format": "pcm16", "output_audio_format": "pcm16", "input_audio_transcription": {"model": "azure-speech", "language": "de", "prompt": null, "custom_speech": null, "phrase_list": null}, "input_audio_noise_reduction": null, "turn_detection": {"type": "azure_semantic_vad_multilingual", "threshold": 0.7, "prefix_padding_ms": 300, "silence_duration_ms": 550, "create_response": true, "interrupt_response": true, "idle_timeout_ms": null, "end_of_utterance_detection": null, "neg_threshold": null, "speech_duration_ms": null, "window_size": null, "distinct_ci_phones": null, "window_size_assistant_speaking": null, "distinct_ci_phones_assistant_speaking": null, "require_vowel": null, "require_vowel_assistant_speaking": null, "remove_filler_words": false, "languages": null, "auto_truncate": false, "appended_text_after_truncation": null}, "tools": [{"name": "end_call", "description": "End the phone call after you have said goodbye to the caller.", "type": "function", "parameters": {"type": "object", "properties": {}}}], "tool_choice": "auto", "max_response_output_tokens": "inf", "expires_at": 1785646667, "object": "realtime.session", "input_audio_sampling_rate": 24000, "animation": null, "input_audio_echo_cancellation": null, "avatar": null, "output_audio_timestamp_types": null, "truncation_strategy": null, "include": null, "greeting": null, "handoff": null}}}
