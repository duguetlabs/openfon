nfirm. Do not promise a confirmed slot.\n- If asked something unrelated to Riverside Dental, politely steer back.\n- When the caller says goodbye, give a brief friendly sign-off.\n", "tools": [{"type": "function", "name": "end_call", "description": "End the phone call after you have said goodbye to the caller.", "parameters": {"type": "object", "properties": {}}}], "tool_choice": "auto", "max_output_tokens": "inf", "tracing": null, "truncation": "auto", "prompt": null, "expires_at": 1785649080, "audio": {"input": {"format": {"type": "audio/pcm", "rate": 24000}, "transcription": {"model": "whisper-1", "language": "de", "prompt": null}, "noise_reduction": null, "turn_detection": {"type": "server_vad", "threshold": 0.7, "prefix_padding_ms": 300, "silence_duration_ms": 550, "idle_timeout_ms": null, "create_response": true, "interrupt_response": true}}, "output": {"format": {"type": "audio/pcm", "rate": 24000}, "voice": "marin", "speed": 1.0}}, "include": null}}}
